@startuml
actor Customer

participant Application
participant Cart
participant Order
participant "Payment Service" as Payment
participant "Warehouse System" as Warehouse
participant Delivery
participant Courier

' --- Browsing and cart ---
Customer -> Application : browseProducts()
Customer -> Application : addToCart(product)
Application -> Cart : addProduct(product)

' --- Create order ---
Customer -> Application : createOrder()
Application -> Cart : getItems()
Cart --> Application : items
Application -> Order : create(items)
Order -> Order : calculateTotal()

' --- Payment ---
Application -> Customer : choosePaymentMethod()

alt Online payment
    Application -> Payment : processPayment()
    
    alt Payment successful
        Payment --> Application : paymentConfirmed
    else Payment failed
        Payment --> Application : paymentFailed
        Application -> Customer : retryPayment()
        return
    end

else Pay on delivery
    Application -> Order : markAsCashPayment()
end

' --- Send to warehouse ---
Application -> Warehouse : sendOrder(order)
Warehouse --> Application : orderAccepted

' --- Warehouse processing ---
Warehouse -> Warehouse : prepareOrder()

alt All products available
    Warehouse -> Order : markReady()
else Some products missing
    alt Substitution allowed
        Warehouse -> Order : replaceProducts()
    else No substitution
        Warehouse -> Order : removeProducts()
    end

    Warehouse -> Order : recalculatePrice()

    alt Online payment
        Warehouse -> Payment : refundDifference()
    else Pay on delivery
        Warehouse -> Courier : notifyNewPrice()
    end
end

' --- Delivery ---
Application -> Delivery : createDelivery(order)
Delivery -> Courier : assignCourier()

Courier -> Delivery : deliverOrder()

alt Payment on delivery
    Courier -> Customer : receivePayment()
end

Courier -> Delivery : confirmDelivery()
Delivery -> Customer : orderDelivered()

@enduml
